# Backend (Render sets these in production; see render.yaml)
# Supabase Session pooler string (Render can't reach Supabase's IPv6-only direct host)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SESSION_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://fridge-book.com/auth/google/redirect
CLIENT_URL=https://fridge-book.com/
# Gemini API keys (Google AI Studio, each in its own project so they have separate free quotas)
GEMINI_RECIPES_API_KEY=
GEMINI_RECEIPTS_API_KEY=
