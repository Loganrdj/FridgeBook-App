# Backend (Render sets these in production; see render.yaml)
# Supabase Session pooler string (Render can't reach Supabase's IPv6-only direct host)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SESSION_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://fridge-book.com/auth/google/redirect
CLIENT_URL=https://fridge-book.com/
# Gemini API keys (Google AI Studio, each in its own project so they have separate free quotas)
GEMINI_RECIPES_API_KEY=
GEMINI_RECEIPTS_API_KEY=
# Recipe search: Spoonacular (free plan) first, then OpenAI web search (paid, capped), then Gemini
SPOONACULAR_API_KEY=
OPENAI_API_KEY=
# Optional caps on paid web searches
WEB_SEARCH_DAILY_LIMIT=5
WEB_SEARCH_MONTHLY_LIMIT=300
# Celiac Mode gluten checks (menus, photos, voice) use this key, or the receipts key if unset
GEMINI_GLUTEN_API_KEY=
# Optional per-user daily limits (defaults shown)
RECIPE_DAILY_LIMIT=20
RECEIPT_DAILY_LIMIT=10
GLUTEN_DAILY_LIMIT=30
RESTAURANT_DAILY_LIMIT=3
MENU_DAILY_LIMIT=10
VOICE_DAILY_LIMIT=20
# Dishes cross-checked against Spoonacular recipes per restaurant or menu check
RECIPE_CROSS_CHECKS=6
# Only while testing the iPhone app in Expo Go: lets sign-ins return to exp:// addresses on a private network
# MOBILE_DEV_REDIRECTS=true
